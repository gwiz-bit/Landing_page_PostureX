# Copy file này thành .env rồi điền giá trị thật — .env không commit lên git.

APP_NAME=PostureX Web
DEBUG=True

# URL backend app PostureX (repo khác) — đang chạy local thì trỏ localhost,
# khi cả hai cùng deploy lên VPS thì đổi sang domain/IP thật của backend app.
POSTUREX_API_BASE_URL=http://localhost:9000/api/v1

# Chuỗi bí mật ký session cookie của web — KHÔNG dùng lại SECRET_KEY của
# backend app. Tạo một chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-chuoi-nay-truoc-khi-chay-that

# ⚠️ BẬT LẠI 14/10/2026 theo quyết định của người dùng (chấp nhận rủi ro
# tạm thời) để làm tính năng đăng ký đầy đủ trên web — LỖ HỔNG BẢO MẬT Ở
# BACKEND APP VẪN CHƯA ĐƯỢC VÁ: POST /auth/verify-otp không giới hạn số
# lần thử OTP, và không ép độ mạnh mật khẩu đủ mạnh ở bước đăng ký. Bật cờ
# này nghĩa là chấp nhận nguy cơ chiếm tài khoản bằng cách dò OTP. Vá đúng
# chỗ (rate-limit /auth/verify-otp theo email + validate password strength)
# nằm ở repo PostureX (app chính), không phải ở web — xem
# backend/app/api/v1/routes/auth.py của repo đó.
REGISTRATION_ENABLED=True

# SePay — tự xác nhận chuyển khoản mua gói Pro. Đặt cùng một chuỗi ngẫu nhiên ở đây và ở
# trang cấu hình webhook của SePay (xác thực kiểu "API Key"). Webhook URL:
# https://<domain-cua-ban>/api/sepay/webhook  (phải là HTTPS công khai, localhost không nhận được).
# Để trống thì webhook từ chối mọi yêu cầu.
SEPAY_API_KEY=
# (Tuỳ chọn) chỉ nhận giao dịch vào đúng số tài khoản này.
SEPAY_ACCOUNT_NUMBER=

# Cổng thanh toán SePay (VietQR) — my.sepay.vn → Cổng thanh toán. Bắt đầu bằng Sandbox.
# MERCHANT ID và SECRET KEY là bí mật, KHÔNG commit. Sandbox và Production là hai bộ khác nhau.
# IPN URL cấu hình bên SePay: https://<domain>/api/sepay/ipn (HTTPS công khai), kiểu xác thực SECRET_KEY.
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=
SEPAY_PG_ENV=sandbox
# (Tuỳ chọn) địa chỉ web công khai cho đường dẫn quay về sau khi thanh toán, vd https://posturex.vn
PUBLIC_BASE_URL=

# Cookie đăng nhập chỉ gửi qua HTTPS (cờ Secure). Mặc định True — giữ nguyên khi chạy thật
# (https://posturex1.com). Chỉ đặt False ở máy dev nếu trình duyệt không nhận cookie Secure
# trên http://localhost (vd Safari).
COOKIE_SECURE=True
