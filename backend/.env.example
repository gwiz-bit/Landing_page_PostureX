# Copy file này thành .env rồi điền giá trị thật — .env không commit lên git.

APP_NAME=PostureX Web
DEBUG=True

# URL backend app PostureX (repo khác) — đang chạy local thì trỏ localhost,
# khi cả hai cùng deploy lên VPS thì đổi sang domain/IP thật của backend app.
POSTUREX_API_BASE_URL=http://localhost:9000/api/v1

# Chuỗi bí mật ký session cookie của web — KHÔNG dùng lại SECRET_KEY của
# backend app. Tạo một chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-chuoi-nay-truoc-khi-chay-that
